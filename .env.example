# ===== LLM: любой OpenAI-совместимый инференс =====
# vLLM / LM Studio / Ollama / llama.cpp-server. Из контейнеров хост
# достижим через host.docker.internal. Примеры:
#   vLLM:      http://host.docker.internal:18020/v1  (enable_thinking=false)
#   LM Studio: http://host.docker.internal:1234/v1
#   Ollama:    http://host.docker.internal:11434/v1
LM_BASE_URL=http://host.docker.internal:1234/v1
LM_API_KEY=lm-studio
LM_MODEL=auto
# reasoning-модели (Qwen3 и т.п.): false -> шлюз передаёт enable_thinking=false
LM_ENABLE_THINKING=false
# Цена за 1M токенов (для оценки стоимости в /monitoring; 0 = не считать)
# LM_PRICE_PROMPT=0
# LM_PRICE_COMPLETION=0

# ===== STT (faster-whisper) =====
# model: tiny | base | small | medium | large-v3
WHISPER_MODEL=medium
# device: auto | cuda | cpu
WHISPER_DEVICE=auto
# compute: auto | float16 (gpu) | int8 (cpu)
WHISPER_COMPUTE_TYPE=auto
# language: ru | en | (empty = autodetect)
WHISPER_LANGUAGE=ru

# ===== GPU =====
GPU_COUNT=all

# ===== Host ports =====
PORT_STT=8100
PORT_TTS=8101
PORT_MOCK=8102
PORT_GATEWAY=8103

# ===== TTS =====
PIPER_VOICE=/voices/ru_RU-dmitri-medium.onnx

# ===== Later: real 1C endpoint instead of mock =====
# STOCK_API_URL=http://mock-api:8000/api/stock

# ===== 1C MCP Toolkit (https://github.com/ROCTUP/1c-mcp-toolkit) =====
# Встроенный HTTP-сервер обработки MCP_Toolkit.epf в 1С:ERP слушает :6003.
# Из контейнеров ходим через host.docker.internal.
ONEC_BASE_URL=http://host.docker.internal:6003/api
ONEC_CHANNEL=
ONEC_TIMEOUT=30

# Источник остатков: "1c" (MCP Toolkit) или "mock" (mock-api).
# При "1c" и ошибке — откат на mock, если STOCK_FALLBACK_TO_MOCK=true.
STOCK_BACKEND=1c
STOCK_FALLBACK_TO_MOCK=true
STOCK_API_URL=http://mock-api:8000/api/stock

# ===== Заказ запчастей (кейс «закажи N штук X») =====
# mock-эндпоинт заказов (контракт для реальной интеграции; фоллбэк при ошибке 1С).
ORDER_API_URL=http://mock-api:8000/api/orders
# Тип документа заказа в 1С (ERP/КА/УТ), создаётся через /api/execute_code.
# Внимание: слово «Записать» по умолчанию в чёрном списке тулкита — уберите его
# из списка опасных слов в форме обработки, иначе заказ оформляется в mock.
ONEC_ORDER_DOC_TYPE=ЗаказПоставщику
