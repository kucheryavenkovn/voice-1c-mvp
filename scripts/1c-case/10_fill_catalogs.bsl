// Этап 1 кейса «запчасть для техники»: справочники (идемпотентно).
// Запуск: python scripts/1c-case/run_bsl.py scripts/1c-case/10_fill_catalogs.bsl
// Данные: fixtures/case-parts/dataset.json (зафиксировано на 2026-07-15, seed 20260715)

Рез = Новый Массив;

// 1) вид номенклатуры — ТОЧНОЕ совпадение (ПОДОБНО нечувствителен к регистру
//    и ловит «Комплектующие и запчасти для бытовой техники»)
Запрос = Новый Запрос;
Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка КАК Ссылка ИЗ Справочник.ВидыНоменклатуры ГДЕ Наименование = &Н";
Запрос.УстановитьПараметр("Н", "Запчасти для спецтехники");
Вид = Неопределено;
Выб = Запрос.Выполнить().Выбрать();
Если Выб.Следующий() Тогда
    Вид = Выб.Ссылка;
    Рез.Добавить("вид:есть");
КонецЕсли;
Если Вид = Неопределено Тогда
    Попытка
        Эл = Справочники.ВидыНоменклатуры.СоздатьЭлемент();
        Эл.Наименование = "Запчасти для спецтехники";
        Эл.Записать();
        Вид = Эл.Ссылка;
        Рез.Добавить("вид:создан");
    Исключение
        Рез.Добавить("вид:ОШИБКА " + ОписаниеОшибки());
    КонецПопытки;
КонецЕсли;

// 2) склады
ИменаСкладов = "Склад инженера|Склад текущего ОП|Склад другого ОП";
СозданоСкладов = 0;
Для Каждого Имя Из СтрРазделить(ИменаСкладов, "|") Цикл
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка КАК Ссылка ИЗ Справочник.Склады ГДЕ Наименование = &И И НЕ ЭтоГруппа";
    Запрос.УстановитьПараметр("И", Имя);
    Выб = Запрос.Выполнить().Выбрать();
    Если НЕ Выб.Следующий() Тогда
        Попытка
            Скл = Справочники.Склады.СоздатьЭлемент();
            Скл.Наименование = Имя;
            Скл.ТипСклада = Перечисления.ТипыСкладов.ОптовыйСклад;
            Скл.Записать();
            СозданоСкладов = СозданоСкладов + 1;
        Исключение
            Рез.Добавить("склад " + Имя + ":ОШИБКА " + ОписаниеОшибки());
        КонецПопытки;
    КонецЕсли;
КонецЦикла;
Рез.Добавить("склады:+" + Формат(СозданоСкладов, "ЧГ=0"));

// 3) единица измерения: из карточки «Уплотнителя» (шт), фоллбэк — «шт»
Ед = Неопределено;
Запрос = Новый Запрос;
Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Номенклатура.ЕдиницаИзмерения КАК Ед ИЗ Справочник.Номенклатура КАК Номенклатура ГДЕ Номенклатура.Наименование ПОДОБНО ""%Уплотнитель%"" И Номенклатура.ЕдиницаИзмерения <> ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)";
Выб = Запрос.Выполнить().Выбрать();
Если Выб.Следующий() Тогда
    Ед = Выб.Ед;
КонецЕсли;
Если Ед = Неопределено Тогда
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка КАК Ссылка ИЗ Справочник.УпаковкиЕдиницыИзмерения ГДЕ Наименование = ""шт""";
    Выб = Запрос.Выполнить().Выбрать();
    Если Выб.Следующий() Тогда
        Ед = Выб.Ссылка;
    КонецЕсли;
КонецЕсли;
Рез.Добавить("единица:" + ?(Ед = Неопределено, "НЕ НАЙДЕНА", Строка(Ед)));

// 4) номенклатура по артикулу: создать / перевести на нужный вид
ЧастиНом = "Диск колесный задний|DK-300~Диск колесный|12345~Диск колесный передний|DK-100~Диск колесный усиленный К-744|DK-744-02~Фильтр масляный|77777~Фильтр топливный|FT-900~Фильтр воздушный|FV-220~Ремень приводной|RB-150~Подшипник ступицы|HB-6205~Аккумуляторная батарея 12В|AB-12-190~Свеча накаливания|SG-001~Насос водяной|WP-300~Тормозная колодка|BP-700~Шланг гидравлический|HG-500~Форсунка топливная|IN-050~Стартер|ST-120~Масло моторное 10W-40 (канистра 10 л)|MO-10W40";
СозданоНом = 0;
Переведено = 0;
Для Каждого Пара Из СтрРазделить(ЧастиНом, "~") Цикл
    Куски = СтрРазделить(Пара, "|");
    Наим = СокрЛП(Куски[0]);
    Арт = СокрЛП(Куски[1]);
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка КАК Ссылка ИЗ Справочник.Номенклатура ГДЕ Артикул = &А И НЕ ЭтоГруппа";
    Запрос.УстановитьПараметр("А", Арт);
    Выб = Запрос.Выполнить().Выбрать();
    Если НЕ Выб.Следующий() Тогда
        Попытка
            Ном = Справочники.Номенклатура.СоздатьЭлемент();
            Ном.Наименование = Наим;
            Ном.Артикул = Арт;
            Ном.ВидНоменклатуры = Вид;
            Ном.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар;
            Если Ед <> Неопределено Тогда
                Ном.ЕдиницаИзмерения = Ед;
            КонецЕсли;
            Ном.Записать();
            СозданоНом = СозданоНом + 1;
        Исключение
            Рез.Добавить("ном " + Арт + ":ОШИБКА " + ОписаниеОшибки());
        КонецПопытки;
    ИначеЕсли Выб.Ссылка.ВидНоменклатуры <> Вид Тогда
        Попытка
            Об = Выб.Ссылка.ПолучитьОбъект();
            Об.ВидНоменклатуры = Вид;
            Об.ОбменДанными.Загрузка = Истина;
            Об.Записать();
            Переведено = Переведено + 1;
        Исключение
            Рез.Добавить("ном " + Арт + ":вид не изменён: " + ОписаниеОшибки());
        КонецПопытки;
    КонецЕсли;
КонецЦикла;
Рез.Добавить("номенклатура:+" + Формат(СозданоНом, "ЧГ=0") + ", вид исправлен:" + Формат(Переведено, "ЧГ=0"));

// 5) объекты эксплуатации (техника)
ИменаОбъектов = "Трактор Кировец К-744Р Гос. № А123ВС04~Трактор МТЗ-82 Гос. № В777ОР04";
СозданоОбъектов = 0;
Для Каждого Имя Из СтрРазделить(ИменаОбъектов, "~") Цикл
    Ключ = СтрРазделить(Имя, " ")[1];
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка КАК Ссылка ИЗ Справочник.ОбъектыЭксплуатации ГДЕ Наименование ПОДОБНО &К И НЕ ЭтоГруппа";
    Запрос.УстановитьПараметр("К", "%" + Ключ + "%");
    Выб = Запрос.Выполнить().Выбрать();
    Если НЕ Выб.Следующий() Тогда
        Попытка
            Об = Справочники.ОбъектыЭксплуатации.СоздатьЭлемент();
            Об.Наименование = Имя;
            Об.Записать();
            СозданоОбъектов = СозданоОбъектов + 1;
        Исключение
            Рез.Добавить("объект " + Ключ + ":ОШИБКА " + ОписаниеОшибки());
        КонецПопытки;
    КонецЕсли;
КонецЦикла;
Рез.Добавить("техника:+" + Формат(СозданоОбъектов, "ЧГ=0"));

Результат = СтрСоединить(Рез, "; ");
