// Этап 2 кейса «запчасть для техники»: поступления (3 документа, июль 2026).
// Запуск: python scripts/1c-case/run_bsl.py scripts/1c-case/20_fill_purchases.bsl
// Шапка копируется с последнего существующего ПриобретениеТоваровУслуг,
// строки — номенклатура кейса по артикулу, запись сразу с проведением.

Рез = Новый Массив;

// склад|артикул=кол;артикул=кол~склад|...
Данные = "Склад инженера|DK-300=1;FT-900=4;FV-220=12;RB-150=6;AB-12-190=6;SG-001=3;BP-700=13;HG-500=5;IN-050=12;MO-10W40=12"
    + "~Склад текущего ОП|DK-300=4;12345=3;FT-900=6;FV-220=6;RB-150=16;HB-6205=15;SG-001=13;WP-300=5;BP-700=11;HG-500=16;MO-10W40=14"
    + "~Склад другого ОП|DK-100=5;DK-744-02=2;FT-900=4;FV-220=5;HB-6205=8;AB-12-190=10;WP-300=8;BP-700=16;HG-500=6;ST-120=13";

// шаблон шапки: последнее существующее поступление «Закупка у поставщика»
// (комиссионные операции порождают виды запасов с валютой — не берём их)
Запрос = Новый Запрос;
Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 ПриобретениеТоваровУслуг.Ссылка КАК Ссылка ИЗ Документ.ПриобретениеТоваровУслуг КАК ПриобретениеТоваровУслуг ГДЕ НЕ ПриобретениеТоваровУслуг.ПометкаУдаления И ПриобретениеТоваровУслуг.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ЗакупкаУПоставщика) УПОРЯДОЧИТЬ ПО ПриобретениеТоваровУслуг.Дата УБЫВ";
Выб = Запрос.Выполнить().Выбрать();
Образец = Неопределено;
Если Выб.Следующий() Тогда
    Образец = Выб.Ссылка.ПолучитьОбъект();
КонецЕсли;
Если Образец = Неопределено Тогда
    Результат = "ERROR|нет ни одного ПриобретениеТоваровУслуг для шаблона шапки";
Иначе
    Для Каждого Блок Из СтрРазделить(Данные, "~") Цикл
        Куски = СтрРазделить(Блок, "|");
        ИмяСклада = Куски[0];
        Запрос = Новый Запрос;
        Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Склады.Ссылка КАК Ссылка ИЗ Справочник.Склады КАК Склады ГДЕ Склады.Наименование = &И";
        Запрос.УстановитьПараметр("И", ИмяСклада);
        Выб = Запрос.Выполнить().Выбрать();
        Если НЕ Выб.Следующий() Тогда
            Рез.Добавить(ИмяСклада + ":СКЛАД НЕ НАЙДЕН");
            Продолжить;
        КонецЕсли;
        НашСклад = Выб.Ссылка;

        Попытка
            Док = Документы.ПриобретениеТоваровУслуг.СоздатьДокумент();
            Док.Дата = Дата("20260715100000");
            Док.Организация = Образец.Организация;
            Док.Партнер = Образец.Партнер;
            Док.Контрагент = Образец.Контрагент;
            Док.Соглашение = Образец.Соглашение;
            Док.Валюта = Образец.Валюта;
            Док.ХозяйственнаяОперация = Образец.ХозяйственнаяОперация;
            Док.ЦенаВключаетНДС = Образец.ЦенаВключаетНДС;
            Док.НалогообложениеНДС = Образец.НалогообложениеНДС;
            // одноэтапная приёмка: без заказов и накладных — иначе проведение
            // пишет «Товары к поступлению» с пустым «Документом поступления»
            Док.ВариантПриемкиТоваров = Перечисления.ВариантыПриемкиТоваров.МожетПроисходитьБезЗаказовИНакладных;
            Док.ПоступлениеПоЗаказам = Ложь;
            Док.Склад = НашСклад;

            // цена/ставка НДС из первой строки образца (если есть)
            Цена = 100;
            Ставка = Неопределено;
            Если Образец.Товары.Количество() > 0 Тогда
                Цена = Образец.Товары[0].Цена;
                Ставка = Образец.Товары[0].СтавкаНДС;
            КонецЕсли;

            Строк = 0;
            Для Каждого Линия Из СтрРазделить(Куски[1], ";") Цикл
                АКуски = СтрРазделить(Линия, "=");
                Арт = СокрЛП(АКуски[0]);
                КолВо = Число(АКуски[1]);
                Запрос = Новый Запрос;
                Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Номенклатура.Ссылка КАК Ссылка, Номенклатура.ЕдиницаИзмерения КАК Ед ИЗ Справочник.Номенклатура КАК Номенклатура ГДЕ Номенклатура.Артикул = &А И НЕ Номенклатура.ЭтоГруппа";
                Запрос.УстановитьПараметр("А", Арт);
                Выб = Запрос.Выполнить().Выбрать();
                Если НЕ Выб.Следующий() Тогда
                    Рез.Добавить(ИмяСклада + ":НЕТ НОМЕНКЛАТУРЫ " + Арт);
                    Продолжить;
                КонецЕсли;
                Стр = Док.Товары.Добавить();
                Стр.Номенклатура = Выб.Ссылка;
                Если Выб.Ед <> NULL Тогда
                    Стр.Упаковка = Выб.Ед;
                КонецЕсли;
                Стр.КоличествоУпаковок = КолВо;
                Стр.Количество = КолВо;
                Стр.Склад = НашСклад;
                Стр.Цена = Цена;
                Стр.Сумма = Цена * КолВо;
                Если Ставка <> Неопределено Тогда
                    Стр.СтавкаНДС = Ставка;
                КонецЕсли;
                Строк = Строк + 1;
            КонецЦикла;

            // двухшаговая запись: сначала Запись (документ получает ссылку —
            // она нужна измерением «Документ поступления» регистра
            // «Товары к поступлению»), затем Проведение
            Док.Записать(РежимЗаписиДокумента.Запись);
            Док = Док.Ссылка.ПолучитьОбъект();
            Док.Записать(РежимЗаписиДокумента.Проведение);
            Рез.Добавить(ИмяСклада + ":№" + Док.Номер + ", строк " + Формат(Строк, "ЧГ=0") + ", проведён");
        Исключение
            Рез.Добавить(ИмяСклада + ":ОШИБКА " + Лев(ОписаниеОшибки(), 1000));
        КонецПопытки;
    КонецЦикла;
    Результат = СтрСоединить(Рез, "; ");
КонецЕсли;
