// Этап 4 кейса: VIN в наименования объектов эксплуатации (идемпотентно).
// Запуск: python scripts/1c-case/run_bsl.py scripts/1c-case/40_add_vin.bsl

Пары = "Трактор Кировец К-744Р Гос. № А123ВС04|XTA00000000012345~Трактор МТЗ-82 Гос. № В777ОР04|XTA00000000077777";
Рез = Новый Массив;
Для Каждого Пара Из СтрРазделить(Пары, "~") Цикл
    Куски = СтрРазделить(Пара, "|");
    СтароеИмя = Куски[0];
    Вин = Куски[1];
    Ключ = СтрРазделить(СтароеИмя, " ")[1];
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Объекты.Ссылка КАК Ссылка, Объекты.Наименование КАК Наим ИЗ Справочник.ОбъектыЭксплуатации КАК Объекты ГДЕ Объекты.Наименование ПОДОБНО &К И НЕ Объекты.ЭтоГруппа";
    Запрос.УстановитьПараметр("К", "%" + Ключ + "%");
    Выб = Запрос.Выполнить().Выбрать();
    Если НЕ Выб.Следующий() Тогда
        Рез.Добавить(Ключ + ":не найден");
    ИначеЕсли СтрНайти(Выб.Наим, "VIN") > 0 Тогда
        Рез.Добавить(Ключ + ":VIN уже есть");
    Иначе
        Об = Выб.Ссылка.ПолучитьОбъект();
        Об.Наименование = СтароеИмя + " VIN " + Вин;
        Об.Записать();
        Рез.Добавить(Ключ + ":VIN добавлен");
    КонецЕсли;
КонецЦикла;
Результат = СтрСоединить(Рез, "; ");
