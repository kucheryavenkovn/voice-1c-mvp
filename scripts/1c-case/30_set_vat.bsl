// Этап 3 кейса: СтавкаНДС = 22% для позиций вида «Запчасти для спецтехники».
// Запуск: python scripts/1c-case/run_bsl.py scripts/1c-case/30_set_vat.bsl

Запрос = Новый Запрос;
Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 СтавкиНДС.Ссылка КАК Ссылка ИЗ Справочник.СтавкиНДС КАК СтавкиНДС ГДЕ СтавкиНДС.Наименование ПОДОБНО ""%22%""";
Выб = Запрос.Выполнить().Выбрать();
Если НЕ Выб.Следующий() Тогда
    Результат = "ERROR|ставка НДС 22% не найдена в справочнике";
Иначе
    Ставка = Выб.Ссылка;
    Запрос2 = Новый Запрос;
    Запрос2.Текст = "ВЫБРАТЬ Номенклатура.Ссылка КАК Ссылка ИЗ Справочник.Номенклатура КАК Номенклатура ГДЕ Номенклатура.ВидНоменклатуры.Наименование = ""Запчасти для спецтехники"" И НЕ Номенклатура.ЭтоГруппа";
    Выб2 = Запрос2.Выполнить().Выбрать();
    Обновлено = 0;
    Пока Выб2.Следующий() Цикл
        Если Выб2.Ссылка.СтавкаНДС <> Ставка Тогда
            Об = Выб2.Ссылка.ПолучитьОбъект();
            Об.СтавкаНДС = Ставка;
            Попытка
                Об.Записать();
                Обновлено = Обновлено + 1;
            Исключение
                Об.ОбменДанными.Загрузка = Истина;
                Об.Записать();
                Обновлено = Обновлено + 1;
            КонецПопытки;
        КонецЕсли;
    КонецЦикла;
    Результат = "OK|ставка " + Строка(Ставка) + ", обновлено позиций: " + Формат(Обновлено, "ЧГ=0");
КонецЕсли;
