      <T-002>
        <Title>Декларативные определения сценариев + loader с валидацией</Title>
        <DependsOn>T-001</DependsOn>
        <AcceptanceCriteria>
          <Criterion>repair_order.yaml и stock_query.yaml вне app.py; некорректная схема не принимается runtime молча.</Criterion>
        </AcceptanceCriteria>
        <Verification>
          <Command>pytest -q tests/test_scenarios.py</Command>
        </Verification>
      </T-002>
