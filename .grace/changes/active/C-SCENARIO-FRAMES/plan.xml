      <T-001>
        <Title>Модели ScenarioFrame/ScenarioField/EntityRef/PendingAction/ScenarioSession</Title>
        <DependsOn />
        <AcceptanceCriteria>
          <Criterion>Статусы полей missing/resolving/ambiguous/resolved/not_found/invalid; коллекции со стабильными item_id; focus-структура.</Criterion>
        </AcceptanceCriteria>
        <Verification>
          <Command>pytest -q tests/test_scenarios.py</Command>
        </Verification>
