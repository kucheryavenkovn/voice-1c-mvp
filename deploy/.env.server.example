# ===== STT (faster-whisper) — CPU-сервер =====
# На CPU: small = быстро/достаточно, medium = точнее, но заметно медленнее
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ru

# ===== Host ports =====
PORT_STT=8100
PORT_TTS=8101
PORT_MOCK=8102
PORT_GATEWAY=8103

# ===== TTS =====
PIPER_VOICE=/voices/ru_RU-dmitri-medium.onnx

# ===== LLM (OpenAI-совместимый инференс на хосте или отдельной машине) =====
# vLLM:      http://host.docker.internal:18020/v1  (enable_thinking=false)
# LM Studio: http://host.docker.internal:1234/v1
LM_BASE_URL=http://host.docker.internal:1234/v1
LM_API_KEY=lm-studio
LM_MODEL=auto
LM_ENABLE_THINKING=false

# ===== 1C MCP Toolkit (обработка MCP_Toolkit.epf слушает :6003) =====
ONEC_BASE_URL=http://host.docker.internal:6003/api
ONEC_CHANNEL=
ONEC_TIMEOUT=30

# Источник остатков: "1c" или "mock" (fallback при ошибке 1С)
STOCK_BACKEND=1c
STOCK_FALLBACK_TO_MOCK=true
STOCK_API_URL=http://mock-api:8000/api/stock
ORDER_API_URL=http://mock-api:8000/api/orders
ONEC_ORDER_DOC_TYPE=ЗаказПоставщику
